<?xml version="1.0" encoding="UTF-8"?>
<!-- Sous-rapport : lignes de facture (JasperReports 7) -->
<jasperReport name="facture-lignes" language="java" pageWidth="555" pageHeight="842" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" whenNoDataType="AllSectionsNoDetail">
	<style name="Base" default="true" fontName="DejaVu Sans" fontSize="8.5"/>
	<field name="reference" class="java.lang.String"/>
	<field name="designation" class="java.lang.String"/>
	<field name="unite" class="java.lang.String"/>
	<field name="quantite" class="java.lang.Integer"/>
	<field name="prixUnitaireHt" class="java.math.BigDecimal"/>
	<field name="tauxTva" class="java.math.BigDecimal"/>
	<field name="montantHt" class="java.math.BigDecimal"/>
	<columnHeader height="20">
		<element kind="rectangle" x="0" y="0" width="555" height="20" backcolor="#EADFC0">
			<pen lineWidth="0.5" lineColor="#5A4630"/>
		</element>
		<element kind="staticText" x="4" y="0" width="76" height="20" bold="true" vTextAlign="Middle">
			<text><![CDATA[Réf.]]></text>
		</element>
		<element kind="staticText" x="84" y="0" width="181" height="20" bold="true" vTextAlign="Middle">
			<text><![CDATA[Désignation]]></text>
		</element>
		<element kind="staticText" x="265" y="0" width="35" height="20" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[Qté]]></text>
		</element>
		<element kind="staticText" x="308" y="0" width="52" height="20" bold="true" vTextAlign="Middle">
			<text><![CDATA[Unité]]></text>
		</element>
		<element kind="staticText" x="360" y="0" width="72" height="20" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[PU HT]]></text>
		</element>
		<element kind="staticText" x="434" y="0" width="38" height="20" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[TVA]]></text>
		</element>
		<element kind="staticText" x="474" y="0" width="77" height="20" bold="true" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[Montant HT]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="18" splitType="Prevent">
			<element kind="textField" x="4" y="2" width="76" height="14" textAdjust="StretchHeight">
				<expression><![CDATA[$F{reference}]]></expression>
			</element>
			<element kind="textField" x="84" y="2" width="181" height="14" textAdjust="StretchHeight">
				<expression><![CDATA[$F{designation}]]></expression>
			</element>
			<element kind="textField" x="265" y="2" width="35" height="14" hTextAlign="Right" textAdjust="StretchHeight">
				<expression><![CDATA[$F{quantite}]]></expression>
			</element>
			<element kind="textField" x="308" y="2" width="52" height="14" textAdjust="StretchHeight">
				<expression><![CDATA[$F{unite}]]></expression>
			</element>
			<element kind="textField" x="360" y="2" width="72" height="14" pattern="#,##0.00 po" hTextAlign="Right" textAdjust="StretchHeight">
				<expression><![CDATA[$F{prixUnitaireHt}]]></expression>
			</element>
			<element kind="textField" x="434" y="2" width="38" height="14" pattern="#,##0.## %" hTextAlign="Right" textAdjust="StretchHeight">
				<expression><![CDATA[$F{tauxTva}]]></expression>
			</element>
			<element kind="textField" x="474" y="2" width="77" height="14" pattern="#,##0.00 po" hTextAlign="Right" textAdjust="StretchHeight">
				<expression><![CDATA[$F{montantHt}]]></expression>
			</element>
			<element kind="line" positionType="Float" x="0" y="17" width="555" height="1" forecolor="#BFB59B">
				<pen lineWidth="0.25" lineColor="#BFB59B"/>
			</element>
		</band>
	</detail>
</jasperReport>
