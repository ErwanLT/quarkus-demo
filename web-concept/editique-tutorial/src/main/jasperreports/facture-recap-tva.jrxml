<?xml version="1.0" encoding="UTF-8"?>
<!-- Sous-rapport : récapitulatif de TVA par taux (JasperReports 7) -->
<jasperReport name="facture-recap-tva" language="java" pageWidth="270" pageHeight="842" columnWidth="270" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" whenNoDataType="AllSectionsNoDetail">
	<!-- Même charte que le maître, qui la transmet en paramètre -->
	<template><![CDATA[$P{CHARTE}]]></template>
	<parameter name="CHARTE" class="java.lang.String">
		<defaultValueExpression><![CDATA["jasperreports/charte-taverne.jrtx"]]></defaultValueExpression>
	</parameter>
	<parameter name="NUMERO_FACTURE" class="java.lang.String"/>
	<field name="taux" class="java.math.BigDecimal"/>
	<field name="baseHt" class="java.math.BigDecimal"/>
	<field name="montantTva" class="java.math.BigDecimal"/>
	<columnHeader height="20">
		<element kind="rectangle" x="0" y="0" width="270" height="20" style="Bandeau"/>
		<element kind="staticText" x="4" y="0" width="50" height="20" style="EnTete" vTextAlign="Middle">
			<text><![CDATA[Taux]]></text>
		</element>
		<element kind="staticText" x="58" y="0" width="100" height="20" style="EnTete" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[Base HT]]></text>
		</element>
		<element kind="staticText" x="162" y="0" width="104" height="20" style="EnTete" hTextAlign="Right" vTextAlign="Middle">
			<text><![CDATA[Montant TVA]]></text>
		</element>
	</columnHeader>
	<detail>
		<band height="18" splitType="Prevent">
			<element kind="textField" x="4" y="2" width="50" height="14" style="Taux" hTextAlign="Left" textAdjust="StretchHeight">
				<expression><![CDATA[$F{taux}]]></expression>
			</element>
			<element kind="textField" x="58" y="2" width="100" height="14" style="Montant" textAdjust="StretchHeight">
				<expression><![CDATA[$F{baseHt}]]></expression>
			</element>
			<element kind="textField" x="162" y="2" width="104" height="14" style="Montant" textAdjust="StretchHeight">
				<expression><![CDATA[$F{montantTva}]]></expression>
			</element>
			<element kind="line" positionType="Float" x="0" y="17" width="270" height="1" style="FiletLeger"/>
		</band>
	</detail>
	<summary height="14">
		<element kind="textField" x="4" y="2" width="266" height="12" style="Note">
			<expression><![CDATA["Détail de la TVA de la facture " + $P{NUMERO_FACTURE}]]></expression>
		</element>
	</summary>
</jasperReport>
