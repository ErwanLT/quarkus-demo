<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>fr.eletutour</groupId>
        <artifactId>quarkus-taverne-extension</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <!--  L'artifactId doit être le préfixe exact de celui du module deployment
             (quarkus-taverne / quarkus-taverne-deployment) : c'est ce couplage
             nominal qui permet à Quarkus de rattacher les BuildItem de la forge
             à cette extension, notamment les cards de la Dev UI.  -->
    <artifactId>quarkus-taverne</artifactId>
    <name>La Taverne</name>
    <!--  Reprise telle quelle dans META-INF/quarkus-extension.yaml : sans elle,
             la Dev UI reçoit une description null et n'affiche plus aucune card.  -->
    <description>Invoque l'esprit de la taverne : journalise chaque quête entreprise par les héros du royaume.</description>
    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!--  Génère META-INF/quarkus-extension.yaml, indispensable pour que
                             Quarkus découvre le module deployment associé à cette extension.  -->
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-extension-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>extension-descriptor</goal>
                        </goals>
                        <phase>process-resources</phase>
                        <configuration>
                            <deployment>fr.eletutour:quarkus-taverne-deployment:${project.version}</deployment>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--  Indexe les classes de ce module (annotations CDI, @ConfigMapping...)
                             pour qu'elles soient visibles au build par l'application consommatrice.  -->
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>